// FogMS: supply the procedural atmosphere disk missing from the native FSSS
// source capture. This is a scene-radiance source, NOT an extra fog integral.
// Include after RENDER_FOG_COMP_TEXTURE_CS has been defined in HeightFogPixelShader.
#pragma once

#include "/Engine/Private/FogMS_Config.ush"

#if FOGMS_ENABLED && FOGMS_BOX_MODE && RENDER_FOG_COMP_TEXTURE_CS && PROJECT_SUPPORT_SKY_ATMOSPHERE && !PERMUTATION_SAMPLE_SKYATMOSPHERE_ON_OPAQUE && !FORWARD_SHADING && UE_BINDLESS_ENABLED && PLATFORM_SUPPORTS_BINDLESS
#define FOGMS_SCREEN_SCATTERING_SOLAR_ENABLED 1
#include "/Engine/Private/SkyAtmosphereCommon.ush"
#else
#define FOGMS_SCREEN_SCATTERING_SOLAR_ENABLED 0
#endif

// SourceUV must be the exact UV used for InputSceneColorTexture. SceneDeviceZ
// is the native FogSeparateCompositionDepth value; do not read SceneTexturesStruct
// here: the native CS declares that uniform but does not bind it at dispatch.
//
// Resident Box texture (0,1).w is the render-thread opt-in. Its producer checks
// native view show flags including DeferredAtmospherePass (not present in View),
// capture exclusions, and single-view/active-valid-Transport scope. The shader
// predicates below restrict this further to the missing procedural sky path.
// Perspective only: orthographic sky uses a different per-pixel camera origin.
float3 FogMS_ScreenScatteringMissingSkyDisk(float2 SourceUV, float SceneDeviceZ)
{
#if FOGMS_SCREEN_SCATTERING_SOLAR_ENABLED
	if (SceneDeviceZ != FarDepthValue
		|| View.SkyAtmospherePresentInScene <= 0.0f
		|| View.RenderingReflectionCaptureMask != 0.0f
		|| View.RealTimeReflectionCapture || IsOrthoProjection()
		|| !IsSkyAtmosphereRenderedInMain(View.EnvironmentComponentsFlags))
	{
		return 0;
	}
	Texture2D<float4> BoxData = GetSRVFromHeap(Texture2D<float4>, FOGMS_BOX_DATA_SRV);
	if (BoxData.Load(int3(0, 1, 0)).w <= .5f || BoxData.Load(int3(0, 0, 0)).w <= .5f)
	{
		return 0;
	}
	const float Mode = BoxData.Load(int3(5, 0, 0)).y;
	const float4 Field = BoxData.Load(int3(22, 0, 0));
	if ((Mode != 4.0f && Mode != 5.0f) || Field.z < .5f || Field.w != 4.0f)
	{
		return 0;
	}

	const float4 SourceSVPos = float4(SourceUV * View.BufferSizeAndInvSize.xy, 0.0f, 1.0f);
	const float3 WorldDir = GetScreenWorldDir(SourceSVPos);
	const float3 PlanetCenterToCamera = (View.SkyCameraTranslatedWorldOrigin
		- View.SkyPlanetTranslatedWorldCenterAndViewHeight.xyz) * CM_TO_SKY_UNIT;
	float3 Disk = 0;
	UNROLL for (uint LightIndex = 0; LightIndex < 2; ++LightIndex)
	{
		// Native helper preserves the angular disk edge, LUT transmittance and
		// virtual-planet occlusion. An absent second atmosphere light has zero
		// luminance and cos(half apex) == 1 in the native View uniform.
		const float3 LightDisk = GetLightDiskLuminance(
			PlanetCenterToCamera, WorldDir,
			View.SkyAtmosphereBottomRadiusKm, View.SkyAtmosphereTopRadiusKm,
			View.TransmittanceLutTexture, View.TransmittanceLutTextureSampler,
			View.AtmosphereLightDirection[LightIndex].xyz,
			View.AtmosphereLightDiscCosHalfApexAngle_PPTrans[LightIndex].x,
			View.AtmosphereLightDiscLuminance[LightIndex].xyz);
		// Match SkyAtmosphere.usf: expose/clamp EACH light before summing.
		Disk += min(LightDisk * View.PreExposure, 64000.0f);
	}
	return Disk;
#else
	return 0;
#endif
}

// Hook ONLY the native SceneColorToScatter input:
//   T * a * (InputSceneColor + FogMS_ScreenScatteringMissingSkyDisk(...))
// Keep FinalFogTransmittanceToScene = T * (1-a) and later SkyAtmosphere unchanged.
// With no blur: L + T*a*D + T*(1-a)*D == L + T*D.
// Native cloud composition subsequently multiplies this source by CloudT before
// FSSS mip generation, and the sharp residual uses T*(1-a)*CloudT as usual.
