#pragma once

// Include after Common.ush. Pair with FFogMSWorldSourcesParameters in the parent
// shader's parameter struct. All positions/distances are translated world / cm.
// No native ForwardLightStruct / ReflectionStruct or shader permutation required.
uint FogMSWorldNumLights;
float FogMSWorldDistanceBiasSqr;
StructuredBuffer<float4> FogMSWorldLights;
TextureCube FogMSWorldSkyTexture;
SamplerState FogMSWorldSkySampler;
TextureCube FogMSWorldSkyBlendTexture;
SamplerState FogMSWorldSkyBlendSampler;
float3 FogMSWorldSkyColor;
float FogMSWorldSkyBlend;
float FogMSWorldSkyMipBias;
float3 FogMSWorldSunDirection;
float FogMSWorldSunExcludeCos;

uint FogMS_WorldLightCount()
{
	return FogMSWorldNumLights;
}

// Includes the isotropic phase 1/(4*pi), native exposure compensation and the
// light's volumetric intensity. The caller applies geometry and medium visibility
// once, then receiver sigma_s. maxDistance=1e27 means a directional light.
void FogMS_WorldLight(uint Index, float3 TranslatedPosition, out float3 Direction,
	out float MaxDistance, out float3 IsotropicIncident, out bool CastShadow)
{
	Direction = float3(0, 0, 1);
	MaxDistance = 0;
	IsotropicIncident = 0;
	CastShadow = false;
	if (Index >= FogMSWorldNumLights) return;
	float4 PositionRadius = FogMSWorldLights[Index * 5u];
	float4 DirectionType = FogMSWorldLights[Index * 5u + 1u];
	float4 ColorInverseSquare = FogMSWorldLights[Index * 5u + 2u];
	float4 SpotFalloffShadow = FogMSWorldLights[Index * 5u + 3u];
	float4 TangentLength = FogMSWorldLights[Index * 5u + 4u];
	float Attenuation = 1.0f;
	if (DirectionType.w < 0.5f)
	{
		Direction = DirectionType.xyz;
		MaxDistance = 1.0e27f;
	}
	else
	{
		float3 ToLight = PositionRadius.xyz - TranslatedPosition;
		float DistanceSqr = dot(ToLight, ToLight);
		MaxDistance = sqrt(max(DistanceSqr, 0.0f));
		Direction = DistanceSqr > 1.0e-12f ? ToLight * rsqrt(DistanceSqr) : DirectionType.xyz;
		float NormalizedDistanceSqr = DistanceSqr * PositionRadius.w * PositionRadius.w;
		if (NormalizedDistanceSqr >= 1.0f) return;
		if (ColorInverseSquare.w > 0.5f)
		{
			float RadiusMask = saturate(1.0f - NormalizedDistanceSqr * NormalizedDistanceSqr);
			float Falloff = rcp(DistanceSqr + FogMSWorldDistanceBiasSqr);
			if (TangentLength.w > 0.0f)
			{
				// Same line irradiance as CapsuleLight.ush / CapsuleLightIntegrate.ush.
				// This affects energy only; geometry/medium visibility uses the centre ray.
				float3 A = ToLight - 0.5f * TangentLength.w * TangentLength.xyz;
				float3 B = ToLight + 0.5f * TangentLength.w * TangentLength.xyz;
				float ProductLengths = sqrt(max(dot(A, A) * dot(B, B), 0.0f));
				Falloff = rcp(max(0.5f * (ProductLengths + dot(A, B)), 0.0f) + FogMSWorldDistanceBiasSqr);
			}
			Attenuation = RadiusMask * RadiusMask * Falloff;
		}
		else
		{
			Attenuation = pow(saturate(1.0f - NormalizedDistanceSqr), SpotFalloffShadow.z);
		}
		if (DirectionType.w > 1.5f)
		{
			// Native SpotAttenuation(L, -LightData.Direction, SpotAngles).
			float Cone = saturate((dot(Direction, DirectionType.xyz) - SpotFalloffShadow.x) * SpotFalloffShadow.y);
			Attenuation *= Cone * Cone;
		}
	}
	IsotropicIncident = ColorInverseSquare.rgb * (Attenuation * 0.07957747154594767f);
	if (!all(isfinite(IsotropicIncident))) IsotropicIncident = 0;
	CastShadow = SpotFalloffShadow.w > 0.5f && MaxDistance > 0.01f;
}

// Escaped sky rays ONLY: radiance, no phase / sigma / View.PreExposure. Native
// View.SkyLightColor removes RTC cached exposure; C++ folds sky volumetric
// intensity exactly once. Do not apply this factor to surface GI or emissive hits.
// SectorSolidAngle > 0: WorldDirection stands for a whole quadrature sector of that
// solid angle (4*pi/AngularCount). The cubemap is then sampled at the mip whose
// texel footprint matches the sector cone, so the ordinate sees the sector-average
// radiance instead of a point sample of a peaky region (the sun aureole). The sky
// light's processed cubemap mips are GGX-prefiltered (specular convolution by
// roughness), which is an acceptable approximation of a sector average here.
// SectorSolidAngle == 0 is the mip-0 point sample (FogMSWorldSkyMipBias not applied).
float3 FogMS_WorldSky(float3 WorldDirection, float SectorSolidAngle)
{
	// The captured cubemap contains the sun disc. Direct sun is already accounted by
	// FogMS_WorldLight with shadows; a sector-weighted quadrature ordinate hitting the
	// disc double counts it. Inside the exclusion cone, sample the sky at the cone
	// boundary instead (same great circle through the sun). ExcludeCos = 2 (no sun,
	// or r.FogMS.World.SunExcludeDegrees 0) never triggers, so the result is unchanged.
	float3 SampleDirection = WorldDirection;
	float CosToSun = dot(WorldDirection, FogMSWorldSunDirection);
	if (FogMSWorldSunExcludeCos < 1.0f && CosToSun > FogMSWorldSunExcludeCos)
	{
		float3 Sun = FogMSWorldSunDirection;
		float3 Perp = WorldDirection - CosToSun * Sun;
		if (dot(Perp, Perp) < 1.0e-8f)
		{
			// Direction coincides with the sun: any unit vector orthogonal to it,
			// built from the sun's smallest-magnitude axis so the cross product is nonzero.
			float3 AbsSun = abs(Sun);
			float3 Axis = (AbsSun.x <= AbsSun.y && AbsSun.x <= AbsSun.z) ? float3(1, 0, 0)
				: (AbsSun.y <= AbsSun.z ? float3(0, 1, 0) : float3(0, 0, 1));
			Perp = cross(Sun, Axis);
		}
		float CosA = FogMSWorldSunExcludeCos;
		float SinA = sqrt(saturate(1.0f - CosA * CosA));
		SampleDirection = normalize(Sun * CosA + normalize(Perp) * SinA);
	}
	// Sector-matched mip, computed after the sun-disc substitution above so the
	// filtered footprint is centred on the substituted (cone boundary) direction.
	float Mip = 0.0f;
	float BlendMip = 0.0f;
	if (SectorSolidAngle > 0.0f)
	{
		// Half-angle of the spherical cap with the sector's solid angle: Omega = 2*pi*(1-cos(theta)).
		// The argument clamp keeps theta in [0, pi/2] (Omega <= 2*pi, a hemisphere).
		float Theta = acos(clamp(1.0f - SectorSolidAngle / (2.0f * PI), 0.0f, 1.0f));
		uint Width, Height, Levels;
		FogMSWorldSkyTexture.GetDimensions(0u, Width, Height, Levels);
		// One cube face spans 90 degrees, so a mip-0 texel subtends ~(pi/2)/Width.
		// Mip m has texels 2^m times wider; match the cone diameter 2*theta.
		float TexelAngle = (0.5f * PI) / max(float(Width), 1.0f);
		Mip = clamp(log2(max(2.0f * Theta / TexelAngle, 1.0f)) + FogMSWorldSkyMipBias, 0.0f, float(max(Levels, 1u) - 1u));
		BlendMip = Mip;
		if (FogMSWorldSkyBlend > 0.0f)
		{
			uint BlendWidth, BlendHeight, BlendLevels;
			FogMSWorldSkyBlendTexture.GetDimensions(0u, BlendWidth, BlendHeight, BlendLevels);
			float BlendTexelAngle = (0.5f * PI) / max(float(BlendWidth), 1.0f);
			BlendMip = clamp(log2(max(2.0f * Theta / BlendTexelAngle, 1.0f)) + FogMSWorldSkyMipBias, 0.0f, float(max(BlendLevels, 1u) - 1u));
		}
	}
	float3 Radiance = FogMSWorldSkyTexture.SampleLevel(FogMSWorldSkySampler, SampleDirection, Mip).rgb;
	if (FogMSWorldSkyBlend > 0.0f)
	{
		float3 Destination = FogMSWorldSkyBlendTexture.SampleLevel(FogMSWorldSkyBlendSampler, SampleDirection, BlendMip).rgb;
		Radiance = lerp(Radiance, Destination, FogMSWorldSkyBlend);
	}
	Radiance *= FogMSWorldSkyColor;
	return all(isfinite(Radiance)) ? max(Radiance, 0.0f) : 0.0f;
}

// Point sample (mip 0); identical to the pre-sector behaviour.
float3 FogMS_WorldSky(float3 WorldDirection) { return FogMS_WorldSky(WorldDirection, 0.0f); }
